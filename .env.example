# Salin menjadi .env, kemudian isi bagian di bawah.
# Email Google pemilik; hanya akun ini yang dapat masuk.
OWNER_EMAIL=

# Dibuat di Google Cloud Console -> Credentials -> OAuth client ID -> Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Alamat aplikasi untuk OAuth redirect, mis. http://localhost:8000
APP_BASE_URL=http://localhost:8000

# Kunci enkripsi permanen untuk refresh token Google.
# Generate dengan: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Folder Google Drive Maktabahrizqy yang sudah dibuat untuk pengguna
DRIVE_FOLDER_ID=

# Atur true bila memakai HTTPS di produksi. Lokal HTTP memakai false.
COOKIE_SECURE=false

# Opsional. Pastikan volume ini persisten di server supaya data bacaan tidak hilang.
DATA_DIR=./data
